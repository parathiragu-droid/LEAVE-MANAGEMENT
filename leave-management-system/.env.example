# ==============================================================================
# Leave Management System - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# MongoDB Connection URI
# Local: mongodb://localhost:27017/leave_management_db
# Atlas: mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/leave_management_db
MONGODB_URI=

# JWT Secret Key (Must be a cryptographically secure random string, min 256 bits)
JWT_SECRET=

# JWT Token Expiration in milliseconds (Default: 86400000 = 24 hours)
JWT_EXPIRATION=

# Frontend Application Origin for CORS (e.g. https://your-frontend-domain.com)
FRONTEND_URL=

# Primary Initial Administrator Account
ADMIN1_EMAIL=
ADMIN1_PASSWORD=

# Secondary Initial Administrator Account
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
